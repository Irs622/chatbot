# Inpartner AI Assistant Environment Variables

# --- AI Model (Optional) ---
# Jika diisi, sistem menggunakan Google Gemini 1.5 Flash untuk elaborasi bahasa alami.
# Jika dikosongkan, sistem tetap berjalan 100% cepat & akurat menggunakan Grounded RAG Engine bawaan.
GEMINI_API_KEY=

# --- Notifikasi Otomatis Leads Masuk (Real-time Lead Notifications) ---
# 1. Webhook (Google Sheets via Apps Script, Zapier, Make, Slack, Discord, atau CRM):
LEAD_WEBHOOK_URL=

# 2. Notifikasi Langsung ke Grup / Akun Telegram Tim Sales/BD (Gratis):
# Dapatkan bot token dari @BotFather di Telegram, dan Chat ID grup/akun Anda.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# 3. Notifikasi Email via Resend (Opsional):
RESEND_API_KEY=
LEAD_NOTIFICATION_EMAIL=corporatesecretary@inpartner.id
