# Inpartner AI Assistant Environment Variables

# --- Supabase Database Configuration (Primary Data Store) ---
# URL and API Keys obtained from your Supabase project dashboard (Settings -> API)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key_here
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your_supabase_publishable_key_here

# Optional: Supabase Service Role Key for backend administrative operations / bypassing RLS
# SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here

# --- Admin CRM Security & Authentication (MANDATORY FOR PRODUCTION) ---
# Password / PIN for accessing the internal dashboard at https://domain/admin
# Replace with a strong, high-entropy password upon production deployment.
ADMIN_PASSWORD=your_admin_password_here

# Secret key for signing admin session cookies (optional, defaults to ADMIN_PASSWORD)
AUTH_SECRET=your_auth_secret_key_here

# --- AI Model Integration (Google Gemini) ---
# When provided, the system utilizes Google Gemini (e.g. gemini-3.8-flash) for real-time natural language reasoning.
# If omitted or unavailable, the system falls back seamlessly to the deterministic Grounded RAG Engine.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

# --- Real-Time Lead Ingestion & Dispatch Notifications ---
# 1. External Webhook (Google Sheets via Apps Script, Zapier, Make, Slack, Discord, or CRM):
LEAD_WEBHOOK_URL=

# 2. Instant Telegram Notification to Sales/BD Telegram Group (Complimentary):
# Acquire your bot token from @BotFather on Telegram, and provide your target Chat ID.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# 3. Transactional Email Notification via Resend (Optional):
RESEND_API_KEY=
LEAD_NOTIFICATION_EMAIL=corporatesecretary@inpartner.id
